# Normalize all text files and store/check them out as LF.
# GoalPilot develops in a Linux Dev Container and deploys to Linux runtimes.
* text=auto eol=lf

# Explicit text formats
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.toml     text eol=lf
*.env      text eol=lf
Dockerfile text eol=lf

# Windows-native command scripts, if we ever add them
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary files must never be line-ending normalized
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.woff     binary
*.woff2    binary