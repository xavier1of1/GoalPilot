{
  "name": "@goalpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./demo-autopilot": {
      "types": "./src/demo-autopilot.ts",
      "development": "./src/demo-autopilot.ts",
      "default": "./dist/demo-autopilot.js"
    }
  },
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@goalpilot/auth": "workspace:*",
    "@goalpilot/contracts": "workspace:*",
    "@goalpilot/data-access": "workspace:*",
    "@goalpilot/domain": "workspace:*",
    "@goalpilot/observability": "workspace:*",
    "@goalpilot/provider-ports": "workspace:*",
    "@goalpilot/provider-simulators": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
