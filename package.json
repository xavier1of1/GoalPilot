{
  "name": "goalpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "setup": "tsx scripts/bootstrap-local.ts",
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors green,blue \"pnpm --filter @goalpilot/api dev\" \"pnpm --filter @goalpilot/web dev\"",
    "doctor": "tsx scripts/doctor.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test:prepare": "tsx scripts/db-test-create.ts && cross-env ENVIRONMENT=test tsx scripts/db-reset.ts --yes && cross-env ENVIRONMENT=test tsx scripts/db-migrate.ts && cross-env ENVIRONMENT=test tsx scripts/db-seed.ts",
    "test": "pnpm test:prepare && cross-env ENVIRONMENT=test NODE_ENV=test vitest run",
    "test:unit": "cross-env ENVIRONMENT=test NODE_ENV=test vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "pnpm test:prepare && cross-env ENVIRONMENT=test NODE_ENV=test vitest run --include '**/*.integration.test.ts'",
    "test:coverage": "pnpm test:prepare && cross-env ENVIRONMENT=test NODE_ENV=test vitest run --coverage",
    "test:e2e": "pnpm test:prepare && playwright test",
    "test:a11y": "pnpm test:prepare && playwright test --grep @a11y",
    "test:security": "vitest run tests/security",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:test": "tsx scripts/db-test-create.ts && cross-env ENVIRONMENT=test tsx scripts/db-reset.ts --yes",
    "db:verify": "tsx scripts/db-verify.ts",
    "demo:advance": "tsx scripts/demo-advance.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "presbom": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\"",
    "sbom": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.5 --out artifacts/sbom.cdx.json",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:verify && pnpm security:scan && pnpm audit:prod && pnpm run sbom"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@goalpilot/auth": "workspace:*",
    "@goalpilot/contracts": "workspace:*",
    "@goalpilot/data-access": "workspace:*",
    "@goalpilot/domain": "workspace:*",
    "@goalpilot/observability": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
